{
  "name": "anya-maxim-invitation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "check:secrets": "node scripts/check-secrets.mjs",
    "telegram:setup": "node --env-file=.env.local scripts/telegram-dev.mjs --setup",
    "telegram:dev": "node --env-file=.env.local scripts/telegram-dev.mjs",
    "test:telegram": "node --test tests/telegram.test.mjs",
    "telegram:check": "node --env-file=.env.local scripts/telegram-dev.mjs --check",
    "telegram:webhook:local": "npm run telegram:webhook",
    "lint": "eslint .",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:dev": "node --env-file=.env.local scripts/migrate.mjs",
    "telegram:webhook": "node --env-file=.env.local scripts/telegram-webhook.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:postgres": "node --env-file=.env.local tests/run-postgres.mjs",
    "start:amvera": "node scripts/start-amvera.mjs",
    "telegram:production": "node scripts/telegram-production.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
