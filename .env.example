# Copy to ignored .env.local; never publish real values.
DATABASE_URL=
# Local Compose only.
DEV_POSTGRES_PASSWORD=
PUBLIC_SITE_URL=http://localhost:3000
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# Amvera: web for website, bot for separate long polling application.
APP_ROLE=web
# Optional one-time approved catalogue import at web startup, only after backup review.
# Existing marker makes restarts idempotent; unmarked non-empty catalogues refuse import.
WISHLIST_IMPORT_ON_START=0
# Production long polling does not need TELEGRAM_WEBHOOK_SECRET.
